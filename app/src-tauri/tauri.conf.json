{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "openkeychron",
  "version": "0.0.0",
  "identifier": "io.github.androlax2.openkeychron",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "openkeychron",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "publisher": "Androlax2",
    "shortDescription": "Remap a Keychron keyboard without Chrome or an account",
    "longDescription": "A native, local-first alternative to Keychron Launcher: remap keys, edit macros, and change lighting and Keychron settings without Chrome, an account or telemetry.",
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-openkeychron.rules": "../../packaging/linux/70-openkeychron.rules"
        }
      }
    }
  }
}
